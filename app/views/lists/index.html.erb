<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(https://img.freepik.com/premium-vector/movie-theater-cinema-design-illustration-banner-template_703262-166.jpg);">
  <div class="container">
    <h1>Save any kind of <strong>Movies</strong>!</h1>
    <p>Classic</p>
  </div>
</div>
<div class="card-container">
  <h2> List of Movies</h2>
  <div class="cards">
    <% @lists.each do |list| %>
      <div class="card-product">
        <div class="card-product-infos">
          <h2><%= link_to list.name, list_path(list) %></h2>
        </div>
      </div>
    <% end %>
    <%= link_to "Add List", new_list_path, class: 'btn btn-primary mt-2' %>
  </div>
</div>
